{
  "name": "reed",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "REED_ENV_FILE=.env.dev expo start",
    "android": "expo start --android",
    "android:dev": "REED_ENV_FILE=.env.dev expo start --android",
    "ios": "expo start --ios",
    "ios:dev": "REED_ENV_FILE=.env.dev expo start --ios",
    "web": "expo start --web",
    "web:dev": "REED_ENV_FILE=.env.dev expo start --web",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "mascot:sheet": "tsx scripts/mascot-sheet.ts",
    "doctor": "npx expo-doctor",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "convex:deploy": "convex deploy",
    "lint": "eslint app components design domains lib --max-warnings 0",
    "lint:details": "eslint app components design domains lib",
    "test:convex": "vitest run --config vitest.convex.config.mts",
    "web:build": "node scripts/export-web.mjs",
    "web:build:dev": "REED_ENV_FILE=.env.dev npm run web:build",
    "icons": "tsx scripts/render-app-icons.ts",
    "web:preview": "npm run web:build && node scripts/prepare-web-preview.mjs && vercel deploy --prebuilt"
  },
