# Convex dev deployment selected by `convex dev`
CONVEX_DEPLOYMENT=dev:your-dev-deployment

# Expo client talking to the dev backend
EXPO_PUBLIC_CONVEX_URL=https://your-dev-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-dev-deployment.convex.site

# Clerk: matching instance for this Convex deployment and the Expo client.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Reed AI provider keys for the dev deployment.
# OPENROUTER_API_KEY powers the final coach reply. OPENAI_API_KEY powers private coach-state refreshes.
# GOOGLE_API_KEY or GEMINI_API_KEY can power Gemini-backed Reed jobs if their model override uses Gemini.
XAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=


LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# PostHog analytics (Expo client)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Optional Reed AI model overrides.
# The final reply model and reasoning are stored in globalSettings, not REED_CHAT_MODEL.
REED_COACH_STATE_MODEL=gpt-5.2
REED_COACH_STATE_REASONING_EFFORT=low
REED_SUMMARY_MODEL=gpt-5.4-mini-2026-03-17
REED_CONTEXT_AGENT_MODEL=gpt-5.4-mini-2026-03-17
REED_CONTEXT_AGENT_REASONING_EFFORT=low
REED_COACHING_MEMORY_MODEL=gpt-5.4-mini-2026-03-17
REED_IMAGE_ANALYSIS_MODEL=gpt-5.4-mini-2026-03-17
REED_PROFILE_INSIGHT_MODEL=gpt-5.4-mini-2026-03-17
REED_STT_MODEL=gpt-4o-mini-transcribe
REED_NOTE_POLISH_MODEL=gpt-5.4-mini-2026-03-17

# Optional secret required by convex/reed.ts:upsertActivePrompt for runtime prompt edits.
REED_CONTROL_PANEL_SECRET=
