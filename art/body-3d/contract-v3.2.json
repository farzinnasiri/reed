{
  "assetVersion": "3.2.0",
  "format": "glTF 2.0 GLB",
  "coordinateConvention": {
    "units": "meters",
    "origin": "midpoint between feet on ground plane",
    "blender": {
      "up": "+Z",
      "front": "-Y",
      "anatomicalLeft": "+X"
    },
    "gltf": {
      "up": "+Y",
      "front": "+Z",
      "anatomicalLeft": "+X"
    },
    "baseHeightMeters": 1.72,
    "pose": "Relaxed standing with arms separated from torso and feet apart."
  },
  "provenance": {
    "project": "Blender Studio and community Human Base Meshes",
    "version": "1.4.1",
    "source": "https://download.blender.org/demo/asset-bundles/human-base-meshes/human-base-meshes-bundle-v1.4.1.zip",
    "assetLicense": "CC0-1.0",
    "licenseEvidence": "https://www.blender.org/download/demo-files/",
    "sourceArchive": "../../art/body-3d/source-data.zip",
    "changes": "Shared male/female anatomy with restrained integrated muscle relief, refined male chest profile, relaxed forearm/hand rotation, common 28K mobile topology, fitted coverage, muscle and pain patches, adiposity and muscularity with combined corrective."
  },
  "architecture": {
    "body": "body",
    "selection": "Raycast body only. Use the final GLB primitive-local triangle index with selectionTriangleRuns. No spatial reclassification after morphing. Torso/arm region boundaries use a separate authored selection field, never the conservative deformation mask.",
    "triangleRunFormat": [
      "startTriangleInclusive",
      "triangleCount",
      "regionIdOrNull"
    ],
    "optimization": "Mapping is generated after export. Accessor compaction preserves triangle and vertex order. Re-export after any geometry changes; do not reorder triangles without regenerating the mapping. Verify the GLB SHA-256.",
    "highlightAddressing": "pain_<id> and muscle_<id> nodes; each has one primitive. Exact node lists per variant.",
    "highlightSurfaceOffsetMeters": 0.00035,
    "highlightEdgeFade": "COLOR_0 alpha, boundary 0 and interior 1; standard glTF vertex color multiplication.",
    "materials": {
      "body": "reed_body_matte",
      "highlight": "reed_highlight",
      "roughness": 0.88,
      "metallic": 0,
      "normalMaps": false,
      "doubleSided": false
    },
    "runtime": "Hide all pain_/muscle_ nodes initially. Clone the shared highlight material per active node; use color and opacity as runtime roles, enable depth test, disable depth write, use FrontSide and polygonOffset factor=-1 units=-1. Render body first. Hide inactive nodes to avoid transparent draw calls.",
    "painMusclePriority": "Prefer one mode at a time. If both are needed, pain renderOrder=2 above muscle renderOrder=1.",
    "coverage": "Embedded neutral 1K atlas with softly edged, low-contrast fitted coverage. Female chest coverage fades toward the sides; the back remains continuous matte clay. All coverage follows body morphs.",
    "backPainPatch": "Dorsal pain patches include only faces that remain back-facing across the authored variants and endpoints. This avoids a tint sliver at the front silhouette; picking catchments remain broader."
  },
